PORT=4000

# Leave DATABASE_URL unset for local dev — an embedded Postgres (pglite) is
# used automatically, persisted to server/.pglite-data/. Set it to a real
# Postgres connection string (e.g. from Neon) for staging/production.
DATABASE_URL=

# Long random string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Best quality — used first for both AI features if set.
ANTHROPIC_API_KEY=

# Optional. Used for both AI features if ANTHROPIC_API_KEY is unset or
# fails. Free, no card required — get a key at aistudio.google.com. Wired
# to gemini-flash-latest (an alias Google keeps pointed at the current
# free-tier flash model, since hardcoded model ids go stale fast on this
# API).
GEMINI_API_KEY=

# Optional. Used for translation only, as a fallback if the above are unset
# or fail. Google Cloud Translation API key (permanent free tier:
# 500k characters/month). Get one at console.cloud.google.com by enabling
# "Cloud Translation API" and creating a restricted API key. If unset, AI
# features fall back further to an unofficial, keyless Google Translate
# endpoint (unreliable from some cloud hosts) and finally the local
# dictionary/phrase bank.
GOOGLE_TRANSLATE_API_KEY=

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173,https://aryansrivastava073.github.io
